<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The iOS target carries only the Game Center capability.  The macOS
	     sandbox, group-session and TCC keys are intentionally not shared. -->
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
