<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ordinary iOS app signing uses the system application sandbox for
	     foreground GPU access. The ad-hoc system-app package has a separate
	     entitlement file for its IOKit user-client allowance. -->
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
